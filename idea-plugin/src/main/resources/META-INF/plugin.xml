<idea-plugin>
    <id>recordbuilder.idea-plugin</id>
    <name>RecordBuilder</name>
    <vendor>RecordBuilder</vendor>

    <description><![CDATA[
        Provides IDE support for the @RecordBuilder annotation processor.
    ]]></description>

    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <java.elementFinder implementation="recordbuilder.idea.RecordBuilderElementFinder" order="first"/>
        <java.shortNamesCache implementation="recordbuilder.idea.RecordBuilderShortNamesCache"/>
        <lang.psiAugmentProvider implementation="recordbuilder.idea.RecordBuilderAugmentProvider"/>
    </extensions>
</idea-plugin>
